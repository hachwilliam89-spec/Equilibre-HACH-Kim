# ---- API ----
NODE_ENV=development
API_PORT=3000

# ---- MongoDB ----
MONGO_PORT=27017
MONGO_ROOT_USER=equilibre
MONGO_ROOT_PASSWORD=changeme
# Le host "mongo" correspond au nom du service dans docker-compose.yml
MONGO_URI=mongodb://equilibre:changeme@mongo:27017/equilibre?authSource=admin

# ---- JWT ----
# Generer des valeurs uniques : openssl rand -hex 32
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# ---- Production uniquement (docker-compose.prod.yml) ----
DOCKER_REGISTRY=registry.gitlab.com/uha40/fil-rouge-2026/4.0.3
IMAGE_TAG=latest
