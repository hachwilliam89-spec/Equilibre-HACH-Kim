# Modele des fichiers d'environnement.
# Copier ce fichier en .env.dev, .env.test et .env.prod, puis renseigner
# des valeurs DIFFERENTES pour chaque environnement (base, utilisateur,
# mot de passe, secrets). Aucun de ces fichiers n'est versionne.
#
# Generer un secret : openssl rand -hex 32

# ---- API ----
# development | test | production
NODE_ENV=development
API_PORT=3000

# ---- MongoDB ----
MONGO_PORT=27017
MONGO_ROOT_USER=equilibre_dev
MONGO_ROOT_PASSWORD=a_generer
# Le hote est "mongo" : le nom du service dans docker-compose.yml.
# La base doit differer selon l'environnement (equilibre_dev,
# equilibre_test, equilibre) pour qu'aucun environnement ne puisse
# ecraser les donnees d'un autre.
MONGO_URI=mongodb://equilibre_dev:a_generer@mongo:27017/equilibre_dev?authSource=admin

# ---- JWT ----
JWT_SECRET=a_generer
JWT_REFRESH_SECRET=a_generer

# ---- Production uniquement (docker-compose.prod.yml) ----
# GitHub Container Registry, alimentee par le job "docker:build" de la
# pipeline GitLab CI. La Container Registry integree a l'instance GitLab
# de l'ecole a ete essayee en premier, mais son port (5050) n'est
# joignable que depuis le reseau du campus, pas depuis un serveur externe
# (voir .gitlab-ci.yml et Page 10 - CI/CD).
# Le serveur de deploiement doit s'authentifier avant de pull (le package
# est prive par defaut) : docker login ghcr.io -u <compte GitHub> -p <PAT
# avec le scope read:packages>.
DOCKER_REGISTRY=ghcr.io/hachwilliam89-spec
IMAGE_TAG=latest
