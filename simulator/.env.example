SIMULATOR_API_URL=https://equilibre.164-132-246-49.sslip.io/api
SIMULATOR_EMAIL=utilisateur@example.com
SIMULATOR_PASSWORD=a_remplacer

# Point de départ utilisé par Faker et variation normale maximale par envoi.
SIMULATOR_BASE_WEIGHT_KG=75
SIMULATOR_MAX_DAILY_VARIATION_KG=0.4

# 86400000 ms = 24 heures. Réduire uniquement pour une démonstration.
SIMULATOR_INTERVAL_MS=86400000

# normal : variation réaliste ; suspect : variation volontairement > 3 kg.
SIMULATOR_MODE=normal

# US4 : total de pas quotidien envoyé par la montre simulée (0 à 50 000).
# SIMULATOR_STEPS=false désactive l'envoi des pas.
SIMULATOR_BASE_STEPS=8000
SIMULATOR_MAX_STEPS_VARIATION=2500

# Facultatif : rend la génération Faker reproductible pour une recette.
# SIMULATOR_SEED=42
